# Valores públicos de desenvolvimento local
POSTGRES_DB=logitrack
POSTGRES_USER=logitrack
POSTGRES_PASSWORD=postgres
DB_PORT=5432

API_PORT=8080
FRONTEND_PORT=4200

# Required: Base64 secret with at least 32 decoded bytes.
